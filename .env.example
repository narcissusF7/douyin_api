# ===========================================================================
# 抖音（抖店）开放平台集成 - 环境变量模板
# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，切勿提交真实密钥。
# ===========================================================================

# --- 抖店开放平台应用凭证（从开放平台后台「应用管理」获取） ---
DOUYIN_APP_KEY=
DOUYIN_APP_SECRET=
# 授权回调地址，需与开放平台后台配置一致
DOUYIN_REDIRECT_URI=
# 授权 scope，多个用半角逗号分隔，按需申请
DOUYIN_SCOPE=

# --- 本脚手架自测用密钥（非抖店平台凭证，仅用于本服务的 API-Key 鉴权与消息推送签名） ---
# 可用以下命令生成： openssl rand -hex 24   (api-key) / openssl rand -hex 32 (message-token)
DOUYIN_API_KEY=
DOUYIN_MESSAGE_TOKEN=
