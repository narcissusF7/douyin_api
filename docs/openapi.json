{"openapi":"3.0.1","info":{"title":"抖音（抖店）开放平台 API","description":"抖店开放平台 Java 集成脚手架接口文档。覆盖授权、店铺、商品、订单、素材、经营数据，以及消息推送订阅。\n\n鉴权：除授权回调与消息推送外，所有 /api/douyin/** 接口需在请求头携带 X-API-Key。在右上角 “Authorize” 中填入与 douyin.api-key 一致的值（本仓库 application.yml 已内置本地联调默认值）。","contact":{"name":"douyin-open-api","email":"dev@example.com"},"version":"1.0.0"},"servers":[{"url":"http://localhost:9090","description":"Generated server url"}],"security":[{"apiKey":[]}],"tags":[{"name":"抖店业务接口","description":"授权、店铺、商品、订单、素材、经营数据；除授权回调外均需 X-API-Key 鉴权"},{"name":"消息推送订阅","description":"接收抖店开放平台消息推送：GET 校验 URL，POST 接收业务事件；由消息签名（SHA1）保护"}],"paths":{"/api/douyin/push":{"get":{"tags":["消息推送订阅"],"summary":"推送 URL 校验","description":"平台配置消息推送地址时发起的 GET 校验，签名正确则原样回显 echostr；由消息签名保护，无需 X-API-Key","operationId":"verify","parameters":[{"name":"signature","in":"query","description":"签名（SHA1(排序(token,timestamp,nonce)拼接)）","required":true,"schema":{"type":"string"}},{"name":"timestamp","in":"query","description":"时间戳","required":true,"schema":{"type":"string"}},{"name":"nonce","in":"query","description":"随机串","required":true,"schema":{"type":"string"}},{"name":"echostr","in":"query","description":"校验回显串","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"string"}}}}}},"post":{"tags":["消息推送订阅"],"summary":"接收业务事件推送","description":"平台推送的业务事件（订单/库存/退款等），先校验签名再分发到对应处理器；由消息签名保护，无需 X-API-Key","operationId":"receive","parameters":[{"name":"signature","in":"query","description":"签名","required":true,"schema":{"type":"string"}},{"name":"timestamp","in":"query","description":"时间戳","required":true,"schema":{"type":"string"}},{"name":"nonce","in":"query","description":"随机串","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"type":"string","description":"事件 JSON 体，含 tag/msg_id/msg 字段"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultString"}}}}}}},"/api/douyin/shops":{"get":{"tags":["抖店业务接口"],"summary":"店铺列表","description":"获取当前授权账号下的店铺列表","operationId":"shops","parameters":[{"name":"shopId","in":"query","description":"店铺 ID（必填）","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultShopListResult"}}}}}}},"/api/douyin/products":{"get":{"tags":["抖店业务接口"],"summary":"商品列表","description":"分页查询商品（支持状态/审核状态筛选）","operationId":"products","parameters":[{"name":"shopId","in":"query","description":"店铺 ID（必填）","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"page","in":"query","description":"页码，从 0 开始","required":false,"schema":{"type":"integer","format":"int32","default":0}},{"name":"size","in":"query","description":"每页条数","required":false,"schema":{"type":"integer","format":"int32","default":10}},{"name":"status","in":"query","description":"商品状态筛选（可选）","required":false,"schema":{"type":"integer","format":"int32"}},{"name":"checkStatus","in":"query","description":"审核状态筛选（可选）","required":false,"schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultProductListResult"}}}}}}},"/api/douyin/products/{productId}":{"get":{"tags":["抖店业务接口"],"summary":"商品详情","description":"按商品 ID 获取商品详情","operationId":"productDetail","parameters":[{"name":"shopId","in":"query","description":"店铺 ID（必填）","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"productId","in":"path","description":"商品 ID（路径参数，必填）","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResultProductInfo"}}}}}}},"/api/douyin/orders":{"get":{"tags":["抖店业务接口"],"summary":"订单列表","description":"分页查询订单（支持订单状态与下单时间区间筛选）","operationId":"orders","parameters":[{"name":"shopId","in":"query","description":"店铺 ID（必填）","required":tru